# Copy this file to .env and fill it in.

# Where the printer is. List one or more, separated by spaces; PrintDrop uses
# the first one that answers. A bare IP address means "work out how to talk
# to it" (raw port 9100, then LPD, then IPP). A full address like
# lpd://HOST/QUEUE is used exactly as written.
#
# The Ricoh shows its own address on its screen: Check Status ->
# Machine Status -> Network -> IPv4 Address.
PRINTER=192.0.2.10

# Only if the printer asks people for a user code before printing.
PRINTER_USER_CODE=

# Share the drop folders over the network (1 = on, 0 = off).
SMB_ENABLED=1
SMB_SHARE_NAME=PrintDrop
# Windows 10/11 won't open guest shares, so give people a simple shared login.
SMB_USER=print
SMB_PASSWORD=print

# Optional: the address printed on the sign, if people should use a name
# other than the one they reached the page with, e.g. http://printdrop.local
PRINTDROP_PUBLIC_URL=
